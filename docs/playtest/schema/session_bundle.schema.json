{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythic-rings.local/schema/playtest/session_bundle.schema.json",
  "title": "Mythic Rings Playtest Session Bundle",
  "type": "object",
  "required": ["schema_version", "session", "characters", "resonance_events", "combat_rounds", "rule_lookups", "issues", "post_session"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session": {
      "type": "object",
      "required": ["session_id", "group_id", "rules_version", "test_mode", "scenario_id", "group_profile", "players_count", "duration_minutes", "preparation_minutes"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}$"},
        "group_id": {"type": "string", "pattern": "^G[0-9]{3}$"},
        "rules_version": {"type": "string", "minLength": 1},
        "test_mode": {"enum": ["internal", "guided_alpha", "closed_beta", "blind"]},
        "scenario_id": {"type": "string", "minLength": 1},
        "group_profile": {"enum": ["internal", "new_to_pbta", "pbta_experienced", "urban_fantasy", "custode_beginner", "mixed", "other"]},
        "players_count": {"type": "integer", "minimum": 2, "maximum": 8},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "preparation_minutes": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "casata", "advancement_tier", "start_pf", "end_pf", "start_stress", "end_stress", "start_corruption", "end_corruption", "start_fate", "end_fate", "powers_used", "decisive_resolutions", "anchor_type", "anchor_level"],
        "properties": {
          "character_id": {"type": "string", "pattern": "^G[0-9]{3}-C[0-9]{2}$"},
          "casata": {"enum": ["Avalon", "Umbra", "Ife", "Mictlan"]},
          "advancement_tier": {"type": "integer", "minimum": 1, "maximum": 5},
          "start_pf": {"type": "integer", "minimum": 0},
          "end_pf": {"type": "integer", "minimum": 0},
          "start_stress": {"type": "integer", "minimum": 0},
          "end_stress": {"type": "integer", "minimum": 0},
          "start_corruption": {"type": "integer", "minimum": 0},
          "end_corruption": {"type": "integer", "minimum": 0},
          "start_fate": {"type": "integer", "minimum": 0},
          "end_fate": {"type": "integer", "minimum": 0},
          "powers_used": {"type": "integer", "minimum": 0},
          "decisive_resolutions": {"type": "integer", "minimum": 0},
          "anchor_type": {"enum": ["person", "family", "community", "place", "ideal", "other"]},
          "anchor_level": {"type": "integer", "minimum": 1, "maximum": 3},
          "casata_resource_name": {"type": ["string", "null"]},
          "casata_resource_start": {"type": ["integer", "null"], "minimum": 0},
          "casata_resource_end": {"type": ["integer", "null"], "minimum": 0},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "resonance_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "character_id", "scene_id", "move_type", "pre_result", "fate_used_before", "procedure_started", "opportunity_spent", "price_1_category", "price_1_text", "price_1_valid", "price_2_category", "price_2_text", "price_2_valid", "choice", "post_result", "decision_seconds", "anchor_used", "clarity_rating", "relevance_rating", "difficulty_rating", "consequence_returned_in_fiction"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-R[0-9]{2}$"},
          "character_id": {"type": "string", "pattern": "^G[0-9]{3}-C[0-9]{2}$"},
          "scene_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-SC[0-9]{2}$"},
          "move_type": {"enum": ["use_power", "exclusive_move"]},
          "pre_result": {"enum": ["6-", "7-9"]},
          "fate_used_before": {"type": "boolean"},
          "procedure_started": {"type": "boolean"},
          "opportunity_spent": {"type": "boolean"},
          "price_1_category": {"enum": ["Corpo", "Anima", "Legame", "Mondo"]},
          "price_1_text": {"type": "string", "minLength": 1},
          "price_1_valid": {"type": "boolean"},
          "price_2_category": {"enum": ["Corpo", "Anima", "Legame", "Mondo"]},
          "price_2_text": {"type": "string", "minLength": 1},
          "price_2_valid": {"type": "boolean"},
          "choice": {"enum": ["Corpo", "Anima", "Legame", "Mondo", "rifiuto"]},
          "post_result": {"enum": ["6-", "7-9", "10+"]},
          "decision_seconds": {"type": "integer", "minimum": 0},
          "anchor_used": {"type": "boolean"},
          "clarity_rating": {"type": "integer", "minimum": 1, "maximum": 5},
          "relevance_rating": {"type": "integer", "minimum": 1, "maximum": 5},
          "difficulty_rating": {"type": "integer", "minimum": 1, "maximum": 5},
          "consequence_returned_in_fiction": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "combat_rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["combat_id", "scene_id", "round_number", "escalation_value", "guardian_significant_actions", "custode_moves", "ignored_threat_moves", "minion_group_activations", "damage_to_guardians", "damage_to_adversaries", "rule_lookups", "order_doubts", "possible_duplicate_enemy_action"],
        "properties": {
          "combat_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-C[0-9]{2}$"},
          "scene_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-SC[0-9]{2}$"},
          "round_number": {"type": "integer", "minimum": 1},
          "escalation_value": {"type": "integer", "minimum": 0},
          "guardian_significant_actions": {"type": "integer", "minimum": 0},
          "custode_moves": {"type": "integer", "minimum": 0},
          "ignored_threat_moves": {"type": "integer", "minimum": 0},
          "minion_group_activations": {"type": "integer", "minimum": 0},
          "damage_to_guardians": {"type": "integer", "minimum": 0},
          "damage_to_adversaries": {"type": "integer", "minimum": 0},
          "rule_lookups": {"type": "integer", "minimum": 0},
          "order_doubts": {"type": "integer", "minimum": 0},
          "possible_duplicate_enemy_action": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "rule_lookups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lookup_id", "rule_or_term", "expected_location", "found_location", "elapsed_seconds", "applied_correctly"],
        "properties": {
          "lookup_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-L[0-9]{2}$"},
          "rule_or_term": {"type": "string", "minLength": 1},
          "expected_location": {"type": "string"},
          "found_location": {"type": "string"},
          "elapsed_seconds": {"type": "integer", "minimum": 0},
          "applied_correctly": {"type": "boolean"},
          "linked_issue_id": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_issue_id", "category", "severity", "observed_behavior", "frequency", "page_or_section"],
        "properties": {
          "session_issue_id": {"type": "string", "pattern": "^G[0-9]{3}-S[0-9]{2}-I[0-9]{2}$"},
          "category": {"enum": ["canon", "rules", "balance", "playtest", "editorial", "production", "other"]},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "observed_behavior": {"type": "string", "minLength": 1},
          "frequency": {"type": "integer", "minimum": 1},
          "page_or_section": {"type": "string"},
          "interpretation_chosen": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "post_session": {
      "type": "object",
      "required": ["second_session_yes_count", "second_session_no_count", "hardest_ring_decision", "rule_confusion", "weak_resonance_price", "spotlight_observation", "milan_element", "rule_search_expectation", "remove_before_add", "comprehension_notes", "preference_notes"],
      "properties": {
        "second_session_yes_count": {"type": "integer", "minimum": 0},
        "second_session_no_count": {"type": "integer", "minimum": 0},
        "hardest_ring_decision": {"type": "string"},
        "rule_confusion": {"type": "string"},
        "weak_resonance_price": {"type": "string"},
        "spotlight_observation": {"type": "string"},
        "milan_element": {"type": "string"},
        "rule_search_expectation": {"type": "string"},
        "remove_before_add": {"type": "string"},
        "comprehension_notes": {"type": "string"},
        "preference_notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
